{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "git -c \"alias.chock-sh=!sh\" chock-sh \"${CURSOR_PLUGIN_ROOT}/scripts/launch.sh\" \"${CURSOR_PLUGIN_ROOT}/scripts/cursor.py\" --guard \"${CURSOR_PLUGIN_ROOT}/scripts/block-no-verify.py\"",
        "timeout": 30
      }
    ]
  }
}
